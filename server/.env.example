PORT=5001
NODE_ENV=development
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project_ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="replace_with_a_secure_high_entropy_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# Administrator Initial Provisioning (Required if no admin exists; must be >= 12 chars in production)
ADMIN_EMAIL="admin@sru.edu.in"
ADMIN_PASSWORD="replace_with_a_secure_high_entropy_password_min_12_chars"

# Test Database Isolation (Required to run database-mutating automated test suites)
# Must point to an isolated test database, separate from production and dev primary database
TEST_DATABASE_URL=""

# Database Seeding Protection (Destructive seeding is prohibited in production unless explicitly set to true)
ALLOW_DESTRUCTIVE_SEED=false

