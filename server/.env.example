# ========================================================
# MentorHub Server Environment Variables (Production & Dev)
# ========================================================

# Server Port and Mode
PORT=5001
NODE_ENV=production

# Database Connection (Supabase PostgreSQL)
# DATABASE_URL: Transaction pooler connection string (Port 6543) with pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct session connection string (Port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT Authentication
# IMPORTANT: In production, generate a secure random 64-char key (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET="your_secure_random_production_jwt_secret_minimum_32_chars"
JWT_EXPIRES_IN="7d"

# Allowed Frontend URL (CORS & CSP)
# IMPORTANT: Must match your hosted frontend domain exactly (e.g., https://mentorhub.vercel.app)
CLIENT_URL="https://your-frontend-domain.vercel.app"

# Primary Administrator Credentials
ADMIN_EMAIL="admin@sru.edu.in"
# In production, must be at least 12 characters and cannot be default 'Password@123'
ADMIN_PASSWORD="YourStrongAdminPassword2026!"
